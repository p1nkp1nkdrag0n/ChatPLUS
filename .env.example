NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/personasim.db
PERSONASIM_PROFILE=development
CLOCK_MODE=system
FAKE_CLOCK_START=2026-08-16T10:00:00.000Z

# fixture works without credentials. Use openai-compatible for DeepSeek.
LLM_PROVIDER=fixture
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_TIMEOUT_MS=120000
OPENAI_COMPATIBLE_MAX_RETRIES=2

LOG_LEVEL=info

# Chat schedule-effect proposals from the live model.
# gated: only high_fidelity characters on intent-detected turns (default).
# off:   pure reply-only live path (the pre-proposal behaviour).
CHAT_EFFECTS_MODE=gated

# Server-owned, versioned schedule agreement workflow.
# legacy:   keep model-authored scheduleEffects as the writer (default).
# shadow:   evaluate structured actions while preserving the legacy writer.
# enforced: only validated server commands may write schedules from chat.
SCHEDULE_NEGOTIATION_MODE=legacy
