NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/personasim.db
PERSONASIM_PROFILE=development
CLOCK_MODE=system
FAKE_CLOCK_START=2026-08-16T10:00:00.000Z

# fixture works without credentials. Use openai-compatible for DeepSeek.
LLM_PROVIDER=fixture
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_TIMEOUT_MS=120000
OPENAI_COMPATIBLE_MAX_RETRIES=2
OPENAI_COMPATIBLE_STRUCTURED_OUTPUT_MODE=json_object
OPENAI_COMPATIBLE_SUPPORTS_THINKING_CONTROL=true
OPENAI_COMPATIBLE_SUPPORTS_STREAMING=false
OPENAI_COMPATIBLE_MAX_CONTEXT_TOKENS=
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=8192

# P1 prompt retention. Raw messages remain stored; these limits bound context.
CONVERSATION_FULL_VERBATIM_HOURS=24
CONVERSATION_SOFT_TOKEN_LIMIT=8000
CONVERSATION_HARD_TOKEN_LIMIT=12000
CONVERSATION_MINIMUM_TAIL_TOKENS=3000
CONVERSATION_MINIMUM_RECENT_TURNS=12

LOG_LEVEL=info

# Chat schedule-effect proposals from the live model.
# gated: only high_fidelity characters on intent-detected turns (default).
# off:   pure reply-only live path (the pre-proposal behaviour).
CHAT_EFFECTS_MODE=gated

# Server-owned, versioned schedule agreement workflow.
# legacy:   keep only model-authored scheduleEffects as the writer.
# shadow:   evaluate structured actions while preserving the legacy writer (default).
# enforced: only validated server commands may write schedules from chat.
SCHEDULE_NEGOTIATION_MODE=shadow

# Character-owned PersonalIntent planning. Start in shadow before enforcement.
SELF_INITIATED_PLANNING=off

# Model world effects are validated independently from reply repair.
LIVE_WORLD_EFFECTS=shadow

# legacy: importance/recency context; shadow: compare evidence recall;
# enforced: inject only the selected EvidenceBundle.
MEMORY_RECALL_MODE=legacy

# P1 checkpoint/autobiography stays disabled until P0 long-run validation passes.
AUTOBIOGRAPHY_MODE=off
