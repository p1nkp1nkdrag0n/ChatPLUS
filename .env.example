NODE_ENV=development
PORT=3001
# Local-only safety boundary. The production self-hosted Compose profile uses
# an explicit authenticated HTTPS reverse-proxy boundary; do not enable it for
# a directly exposed process.
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
SELFHOSTED_REVERSE_PROXY=false
SERVE_WEB=false
WEB_DIST_PATH=./apps/web/dist
DATABASE_PATH=./data/personasim.db
PERSONASIM_PROFILE=development
CLOCK_MODE=system
FAKE_CLOCK_START=2026-08-16T10:00:00.000Z

# fixture works without credentials. Use openai-compatible for a live profile.
LLM_PROVIDER=fixture

# Select claude, grok, gemini, gpt56-sol, or bigmodel at startup.
# Leave blank while using fixture.
# Profile names are case-insensitive; "claude" maps to LLM_PROFILE_CLAUDE_*.
# Reasoning-enabled profiles use the client maximum of five minutes per
# physical attempt so long-thinking responses are not cut off at 120 seconds.
LLM_ACTIVE_PROFILE=

# Claude Opus 4.6 through the third-party Wanzhao OpenAI-compatible gateway.
LLM_PROFILE_CLAUDE_BASE_URL=https://sub.wanzhao.top/v1
LLM_PROFILE_CLAUDE_API_KEY=
LLM_PROFILE_CLAUDE_MODEL=claude-opus-4-6
LLM_PROFILE_CLAUDE_TIMEOUT_MS=300000
LLM_PROFILE_CLAUDE_MAX_RETRIES=1
LLM_PROFILE_CLAUDE_STRUCTURED_OUTPUT_MODE=prompt_json
LLM_PROFILE_CLAUDE_REASONING_EFFORT=medium
LLM_PROFILE_CLAUDE_REASONING_FORMAT=anthropic_output_config
LLM_PROFILE_CLAUDE_SUPPORTS_THINKING_CONTROL=false
LLM_PROFILE_CLAUDE_SUPPORTS_STREAMING=false
LLM_PROFILE_CLAUDE_MAX_CONTEXT_TOKENS=1000000
LLM_PROFILE_CLAUDE_MAX_OUTPUT_TOKENS=32768

# Grok 4.6 through Wanzhao, with a dedicated gateway key.
LLM_PROFILE_GROK_BASE_URL=https://sub.wanzhao.top/v1
LLM_PROFILE_GROK_API_KEY=
LLM_PROFILE_GROK_MODEL=grok-4.6
LLM_PROFILE_GROK_TIMEOUT_MS=300000
LLM_PROFILE_GROK_MAX_RETRIES=1
LLM_PROFILE_GROK_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROFILE_GROK_REASONING_EFFORT=medium
LLM_PROFILE_GROK_REASONING_FORMAT=openai_reasoning_effort
LLM_PROFILE_GROK_SUPPORTS_THINKING_CONTROL=false
LLM_PROFILE_GROK_SUPPORTS_STREAMING=false
LLM_PROFILE_GROK_MAX_CONTEXT_TOKENS=500000
LLM_PROFILE_GROK_MAX_OUTPUT_TOKENS=32768

# Gemini 3.7 Flash through Wanzhao, with a dedicated gateway key.
LLM_PROFILE_GEMINI_BASE_URL=https://sub.wanzhao.top/v1
LLM_PROFILE_GEMINI_API_KEY=
LLM_PROFILE_GEMINI_MODEL=gemini-3.7-flash
LLM_PROFILE_GEMINI_TIMEOUT_MS=300000
LLM_PROFILE_GEMINI_MAX_RETRIES=1
LLM_PROFILE_GEMINI_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROFILE_GEMINI_REASONING_EFFORT=medium
LLM_PROFILE_GEMINI_REASONING_FORMAT=openai_reasoning_effort
LLM_PROFILE_GEMINI_SUPPORTS_THINKING_CONTROL=false
LLM_PROFILE_GEMINI_SUPPORTS_STREAMING=false
LLM_PROFILE_GEMINI_MAX_CONTEXT_TOKENS=1048576
LLM_PROFILE_GEMINI_MAX_OUTPUT_TOKENS=32768

# GPT-5.6 Sol through Wanzhao, with a dedicated gateway key.
LLM_PROFILE_GPT56_SOL_BASE_URL=https://sub.wanzhao.top/v1
LLM_PROFILE_GPT56_SOL_API_KEY=
LLM_PROFILE_GPT56_SOL_MODEL=gpt-5.6-sol
LLM_PROFILE_GPT56_SOL_TIMEOUT_MS=300000
LLM_PROFILE_GPT56_SOL_MAX_RETRIES=1
LLM_PROFILE_GPT56_SOL_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROFILE_GPT56_SOL_REASONING_EFFORT=medium
LLM_PROFILE_GPT56_SOL_REASONING_FORMAT=openai_reasoning_effort
LLM_PROFILE_GPT56_SOL_SUPPORTS_THINKING_CONTROL=false
LLM_PROFILE_GPT56_SOL_SUPPORTS_STREAMING=false
LLM_PROFILE_GPT56_SOL_MAX_CONTEXT_TOKENS=1050000
LLM_PROFILE_GPT56_SOL_MAX_OUTPUT_TOKENS=32768

# Zhipu BigModel OpenAI-compatible API.
LLM_PROFILE_BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_PROFILE_BIGMODEL_API_KEY=
LLM_PROFILE_BIGMODEL_MODEL=glm-5.3-flash
LLM_PROFILE_BIGMODEL_TIMEOUT_MS=300000
LLM_PROFILE_BIGMODEL_MAX_RETRIES=1
LLM_PROFILE_BIGMODEL_STRUCTURED_OUTPUT_MODE=json_object
LLM_PROFILE_BIGMODEL_REASONING_EFFORT=max
LLM_PROFILE_BIGMODEL_REASONING_FORMAT=openai_reasoning_effort_with_thinking
LLM_PROFILE_BIGMODEL_SUPPORTS_THINKING_CONTROL=false
LLM_PROFILE_BIGMODEL_SUPPORTS_STREAMING=false
LLM_PROFILE_BIGMODEL_MAX_CONTEXT_TOKENS=1000000
LLM_PROFILE_BIGMODEL_MAX_OUTPUT_TOKENS=32768

# Backward-compatible single-provider settings. These are read only when
# LLM_ACTIVE_PROFILE is blank.
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_TIMEOUT_MS=300000
OPENAI_COMPATIBLE_MAX_RETRIES=2
OPENAI_COMPATIBLE_STRUCTURED_OUTPUT_MODE=json_object
OPENAI_COMPATIBLE_REASONING_EFFORT=max
OPENAI_COMPATIBLE_REASONING_FORMAT=openai_reasoning_effort_with_thinking
OPENAI_COMPATIBLE_SUPPORTS_THINKING_CONTROL=false
OPENAI_COMPATIBLE_SUPPORTS_STREAMING=false
OPENAI_COMPATIBLE_MAX_CONTEXT_TOKENS=131072
OPENAI_COMPATIBLE_MAX_OUTPUT_TOKENS=32768

# P1 prompt retention. Raw messages remain stored; these limits bound context.
CONVERSATION_FULL_VERBATIM_HOURS=24
CONVERSATION_SOFT_TOKEN_LIMIT=8000
CONVERSATION_HARD_TOKEN_LIMIT=12000
CONVERSATION_MINIMUM_TAIL_TOKENS=3000
CONVERSATION_MINIMUM_RECENT_TURNS=12

LOG_LEVEL=info

# Chat schedule-effect proposals from the live model.
# gated: only high_fidelity characters on intent-detected turns (default).
# off:   pure reply-only live path (the pre-proposal behaviour).
CHAT_EFFECTS_MODE=gated

# Legacy exact-schedule compatibility only. `off` is the product default;
# legacy/shadow/enforced are honored only with LIFE_PLANNING_MODE=legacy_exact.
# legacy:   keep only model-authored scheduleEffects as the writer.
# shadow:   evaluate structured actions while preserving the legacy writer.
# enforced: only validated server commands may write exact schedules from chat.
# Character life is otherwise represented as fuzzy daily context.
LIFE_PLANNING_MODE=fuzzy
SCHEDULE_NEGOTIATION_MODE=off

# Legacy Character-owned PersonalIntent -> exact ScheduleItem projection.
# Keep off for fuzzy life; shadow/enforced are migration comparison modes only.
SELF_INITIATED_PLANNING=off

# Model world effects are validated, bounded and committed by the server.
# Fixture and real providers pass through the same commit path.
LIVE_WORLD_EFFECTS=enforced

# enforced (default): inject only persisted, verified EvidenceBundle sources.
# shadow compares the evidence hierarchy without replacing legacy prompt input;
# legacy remains available for a bounded rollback/migration comparison.
MEMORY_RECALL_MODE=enforced

# enforced (default): create retention checkpoints/autobiography revisions when
# thresholds are met and inject the latest verified snapshot into later turns.
AUTOBIOGRAPHY_MODE=enforced

# Temporal correspondence is implemented behind a disabled-by-default rollout
# boundary. shadow commits deterministic arrival/snapshot work but never calls
# the reply model; enforced enables the full encrypted reply lifecycle.
CORRESPONDENCE_MODE=off

# lazy catches up on startup and relevant requests; resident keeps a local
# server timer; worker uses database leases in a self-hosted process.
CORRESPONDENCE_EXECUTION=lazy

# fixed_5d_v1 is the only first-version policy. Its computed due timestamp is
# frozen when a letter is sealed and is not changed by later defaults.
CORRESPONDENCE_TRANSIT_POLICY=fixed_5d_v1
CORRESPONDENCE_GENERATION_LEASE_MS=1800000
CORRESPONDENCE_MAX_OPEN_THREADS=1

# Digital keepsakes are read-only in off, eligibility-observation-only in
# shadow, and enqueue/template-or-image-generation capable only in enforced.
# Existing ready keepsakes and their source chains remain readable in all modes.
KEEPSAKE_MODE=off
# Content-addressed WebP originals and thumbnails live here; SQLite stores only
# hashes and metadata. Use a different isolated path for every friend instance.
ASSET_STORAGE_PATH=./data/assets

# Canonical Base64 for at least 32 random bytes. It is mandatory in enforced
# mode and whenever this database already contains a key fingerprint or
# encrypted correspondence—even in off/shadow, so history remains decryptable.
# Never share one secret between friend instances or commit it to the repo.
INSTANCE_SECRET=
