# Copy to a private location. Set DEARVALE_HOSTED_CONFIG to its absolute path.
# The hosted server never reads the repository's normal .env.
DEARVALE_HOSTED_ROOT=C:/DearvaleServer
DEARVALE_HOSTED_PORT=3001
DEARVALE_ADMIN_PORT=3002
# Leave unset for local setup; set a stable HTTPS origin before sharing clients.
# DEARVALE_PUBLIC_ORIGIN=https://your-public-host.example
# Only forward port 3001 and preserve the original public Host header.
# Trust forwarding metadata only after confirming that the proxy overwrites
# untrusted X-Forwarded-For or appends the actual client IP. Unset trusts none.
# Use the proxy's exact source IP/CIDR, not a hop count or a public network range.
# For a verified local HTTP proxy only:
# DEARVALE_HOSTED_TRUSTED_PROXIES=127.0.0.1,::1
# Credentials, models, prices, invitations and budgets are configured in the local console.
CORRESPONDENCE_MODE=enforced
KEEPSAKE_MODE=off
COMPANION_CONTEXT_MODE=off
PERSONA_RUNTIME_MODE=off
## Proactive messages are independently scheduled per loaded tenant runtime.
PROACTIVE_MODE=shadow
PROACTIVE_EXECUTION=resident
