# Copy this file outside source control, use a distinct copy per friend, and
# run Compose with: docker compose --env-file .env.friend-a ...
CHATPLUS_INSTANCE_NAME=friend-a
CHATPLUS_DOMAIN=friend-a.example.com
ACME_EMAIL=operator@example.com

# Placeholders only. Generate a bcrypt hash with `caddy hash-password` and a
# distinct 32-byte Base64 secret with a cryptographically secure generator.
# When replacing the hash, keep it inside single quotes so Compose treats the
# bcrypt `$` characters literally, for example: '$2a$14$...'.
CHATPLUS_BASIC_AUTH_USER=replace-me
CHATPLUS_BASIC_AUTH_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
INSTANCE_SECRET=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_SECRET

CHATPLUS_ENV_FILE=.env.friend-a
# Compose deliberately refuses to create these paths. Pre-create all four,
# keep them outside Git, and make them writable by container UID 1000.
CHATPLUS_DATA_DIR=./instances/friend-a/data
CHATPLUS_ASSETS_DIR=./instances/friend-a/assets
CHATPLUS_LOG_DIR=./instances/friend-a/logs
CHATPLUS_BACKUP_DIR=./instances/friend-a/backups

PERSONASIM_PROFILE=high_fidelity
SEED_DEMO=true
CLOCK_MODE=system
CORRESPONDENCE_MODE=enforced
CORRESPONDENCE_EXECUTION=worker
CORRESPONDENCE_TRANSIT_POLICY=fixed_5d_v1
CORRESPONDENCE_GENERATION_LEASE_MS=1800000
CORRESPONDENCE_MAX_OPEN_THREADS=1
KEEPSAKE_MODE=off

# fixture starts without an API key. Configure one of the documented live
# OpenAI-compatible profiles before using model-backed friend testing.
LLM_PROVIDER=fixture
LLM_ACTIVE_PROFILE=
LOG_LEVEL=info
