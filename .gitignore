# Generated content belongs in the directory roots below, not beside source.
# Directory rules cover every run name, nesting level, and generated file type.

# Dependencies, build output, and local tool caches (all workspaces).
node_modules/
.pnpm-store/
dist/
dist-website/
.cache/
.vite/
.vite-temp/
.eslintcache
*.tsbuildinfo

# Android build output and private signing material.
/apps/android/.gradle/
/apps/android/build/
/apps/android/app/build/
/apps/android/app/src/main/assets/web/
/apps/android/local.properties
*.jks
*.keystore
*.p12
*.pfx
.secrets/

# Distributable installers belong in release assets, never source history.
*.exe
*.msi
*.apk
*.aab
*.dmg
*.AppImage
*.blockmap

# Test output (all workspaces).
coverage/
playwright-report/
test-results/
blob-report/

# Runtime data and generated assets. Keep only the empty directory marker.
# Ignoring each immediate child also excludes its complete subtree.
/data/*
!/data/.gitkeep

# Conventional local output directories, including package-local runs.
# New simulations and tools must use these directories instead of per-run rules.
tmp/
temp/
artifacts/
# Local Dearvale presentation deliverables, source assets, and slide previews.
/artifacts/presentations/
instances/
logs/
backups/

# Local secrets. Keep only the documented template.
.env
.env.*
!.env.example
!.env.selfhosted.example
!.env.hosted.example
*.local
*.llm-key
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Local reports, experiment results, and historical planning records.
# Reusable test inputs live with test fixtures; public protocols stay in docs/evals.
/docs/reports/
/docs/plans/
/docs/PRODUCT_LIFE_REMEDIATION.md
/docs/evals/research-optimization.md
/docs/evals/reply-steering/RESULTS.md
/docs/evals/reply-steering/QUANTITATIVE.md
/docs/evals/reply-steering/SCENE_COMPARISONS.md
/docs/evals/reply-steering/evidence/

# Local visual acceptance evidence. Product artwork remains versioned.
/docs/design/**/qa/
/docs/design/achievements/wax-seal-references/qa.json
/docs/design/achievements/wax-wall-desktop.png
/docs/design/achievements/wax-wall-mobile.png
/docs/design/memory-library/

# Local unresolved issues and investigation notes.
/docs/issue/

# Personal launchers depend on scripts provisioned outside the checkout.
/启动Dearvale.cmd
/关闭Dearvale.cmd
